EPIC_FHIR_BASE_URL=https://your-epic-instance.example.org/api/FHIR/R4
EPIC_CLIENT_ID=your_epic_client_id_here
EPIC_CLIENT_SECRET=your_epic_client_secret_here
EPIC_TOKEN_URL=https://your-epic-instance.example.org/oauth2/token

# Number of days a claim may sit without a status update before it is
# considered orphaned.
ORPHAN_THRESHOLD_DAYS=14

# Supabase project used to persist de-identified diagnostic telemetry
# (HMAC token IDs, waterfall stage/rule metadata - never PHI). Leave both
# blank to run with Supabase persistence disabled; supabase_writer.py
# soft-fails and no-ops when either is unset.
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# JWT Secret for verifying Supabase Auth tokens (E5 security)
# Get this from Supabase project settings: Project > API > JWT Secret
# WARNING: This secret must match Supabase project configuration
# DO NOT expose this in logs, version control, or error messages
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_key

# Identifies this deployment's client organization in client_configurations.
# One dashboard instance = one tenant (no login/auth layer exists yet).
TENANT_ID=default

# SSL Certificate Verification (Development/Testing)
# Set to 'false' to disable SSL verification for self-signed certificates
# IMPORTANT: Only for development/testing. Always use true (default) in production.
SSL_VERIFY=true
